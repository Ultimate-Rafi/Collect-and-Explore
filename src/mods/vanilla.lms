-- Collectibles
api.set.default("collectible", {
    size = api.get.cell_size() * 0.4,
    mults = {},
    value = 1,
    max = 32
})


api.new.collectible({
    name = "gold",
    color = api.rgb(247, 247,0, 100),
    chance = 7.5,
    inv_slot = "Gold"
})

api.new.collectible({
    name = "iron",
    color = api.rgb(240, 240, 240, 100),
    chance = 15,
    inv_slot = "Iron"
})

api.new.collectible({
    name = "amethyst",
    color = api.rgb(255, 0, 255, 100),
    chance = 3,
    inv_slot = "Amethyst"
})

api.new.collectible({
    name = "diamond",
    color = api.rgb(67, 255, 255, 100),
    chance = 0.01,
    inv_slot = "Diamond"
})

api.new.collectible({
    name = "obsidian",
    color = api.rgb(67, 0, 67),
    chance = 0.7,
    inv_slot = "Obsidian"
})

api.new.collectible({
    name = "mytheril",
    color = api.rgb(10, 60, 70),
    chance = 0.0001,
    inv_slot = "Mytheril",
    value = 0.25
})

api.set.inv_order({
    "Iron",
    "Gold",
    "Amethyst",
    "Obsidian",
    "Diamond",
    "Mytheril"
})

api.set.coll.spawn_rate(6.7)
api.set.coll.rolls(2)
api.set.coll.max(28)

-- Buttons

api.new.button({
    name = "f3",
    id = "vanilla:f3",
    x = api.get.screen.width() - 50,
    y = 3,
    height = 47,
    width = 47,
    txt = "f3",
    act_t = function()
        api.set.f3(not api.get.f3())
    end
})

api.new.button({
    name = "inventory_o",
    id = "vanilla:inventory_open",
    x = api.get.screen.width() - 50,
    y = 60,
    height = 47,
    width = 47,
    txt = "inv",
    act_t = function()
        --api.set.inv(not api.get.inv())
        
        api.inv.open("vanilla:main_inventory")
        api.set.menu("inventory")
    end
})

api.new.button({
    name = "inventory_c",
    id = "vanilla:inventory_close",
    x = api.get.screen.width() - 50,
    y = 60,
    height = 47,
    width = 47,
    txt = "X",
    act_t = function()
        api.inv.close()
        api.set.menu("game")
    end
})

api.new.button({
    name = "sprint",
    id = "vanilla:sprint",
    x = api.get.screen.width() * 0.75,
    y = api.get.screen.height() * 0.5,
    height = 60,
    width = 60,
    txt = ">>",
    attributes = {
        mana = 100,
    },
    act_t = function(attribs)
        --local mana = attribs.mana
        --if attribs.mana and attribs.mana > 0 then
        api.set.player.max_speed(400)
        api.set.player.min_speed(120)
        --end
        --api.draw.txt("mana", "Mana: "..(attribs.mana or -1))
    end,
    act_h = function(attribs)
        if attribs.mana and attribs.mana > 0 then
            api.set.player.max_speed(500)
            api.set.player.min_speed(150)
            attribs.mana = math.max(0, attribs.mana - 10 * api.get.dt())
        else
            api.set.player.max_speed(250)
            api.set.player.min_speed(50)
            --attribs.mana = math.min(100, attribs.mana + 3)
        end
        
        api.draw.txt("mana", "Mana: " .. math.floor(attribs.mana))
    end,
    act_i = function(attribs)
        
        --if attribs.mana and attribs.mana < 98 then
    --        attribs.mana = (attribs.mana or 0) + 3
--        end
        
        attribs.mana = math.min(100, attribs.mana + 4 * api.get.dt())
        api.draw.txt("mana", "Mana: ".. math.floor(attribs.mana))
    end,
    act_r = function(attribs)
        api.set.player.max_speed(250)
        api.set.player.min_speed(50)
        
        --api.draw.txt("mana", "Mana: "..(attribs.mana or -1))
    end
})

-- Menus

api.new.menu("game",
    {"world", "player", "joystick", "hud", "inventory", "collectible"},
    {
        "vanilla:f3",
        "vanilla:inventory_open",
        "vanilla:sprint"
    }
)

api.new.menu("inventory",
    {"world","player","inventory"},
    {
        "vanilla:inventory_close"
    }
)


api.set.menu("game")

api.new.inventory("player", "vanilla:main_inventory", 9, 3, 50)


